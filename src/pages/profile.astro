---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Perfil y Trayectoria | Álvaro Fernández Ramos";
const description = "Perfil profesional: ingeniero de software full-stack, desarrollo web y Android, backend, bases de datos y sistemas.";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <BaseHead title={title} description={description} />
</head>
<body>
    <Header />

    <main class="container layout-wrapper">
        <div class="page-top-nav reveal-up">
            <a href="/" class="back-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
                <span>Volver al inicio</span>
            </a>
        </div>

        <header class="page-header reveal-up">
            <div class="badge-chip cyan">PERFIL // SOFTWARE & SYSTEMS ENGINEER</div>
            <h1 class="page-title">
                Trayectoria y <br>
                <span class="text-cyan" data-scramble="enfoque de ingeniería.">enfoque de ingeniería.</span>
            </h1>
            <p class="page-desc">
                Ingeniero informático con mentalidad de constructor integral: desarrollo aplicaciones completas para web y Android, diseño APIs y automatizaciones eficientes, y domino la seguridad y el bajo nivel.
            </p>

            <div class="profile-actions-bar">
                <button class="btn-tactile btn-primary" data-copy="alvarofdezr@gmail.com" data-copy-label="Email copiado al portapapeles">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    <span>Copiar correo directo</span>
                </button>

                <a href="https://github.com/alvarofdezr" target="_blank" rel="noopener noreferrer" class="btn-tactile btn-secondary">
                    <span>GitHub: @alvarofdezr</span>
                    <span class="arrow-up">↗</span>
                </a>

                <a href="https://www.linkedin.com/in/%C3%A1lvaro-fern%C3%A1ndez-71b25a404" target="_blank" rel="noopener noreferrer" class="btn-tactile btn-ghost">
                    <span>LinkedIn</span>
                    <span class="arrow-up">↗</span>
                </a>
            </div>
        </header>

        <div class="profile-split-layout">
            <!-- Left Column: Quick Info & Timeline -->
            <aside class="profile-aside reveal-up">
                <!-- Quick Spec Card -->
                <div class="spec-card spotlight-card">
                    <div class="spec-header">
                        <span class="beacon-dot"></span>
                        <span class="spec-title">TELEMETRÍA // PERFIL</span>
                    </div>
                    <div class="spec-list">
                        <div class="spec-item">
                            <span class="spec-k">UBICACIÓN:</span>
                            <span class="spec-v">Sevilla, España</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-k">ROL:</span>
                            <span class="spec-v text-cyan">Software Engineer // Full-Stack, Mobile & Systems</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-k">DOMINIO:</span>
                            <span class="spec-v">Web SPAs, Android (APK), Python, Go, C, SQLite, Automatizaciones</span>
                        </div>
                    </div>
                </div>

                <!-- Timeline -->
                <div class="timeline-box spotlight-card">
                    <h3 class="timeline-heading">Hitos y Proyectos</h3>
                    
                    <div class="timeline-events">
                        <div class="event-item">
                            <span class="event-dot emerald"></span>
                            <div class="event-meta">
                                <span class="event-date">ÚLTIMO LANZAMIENTO</span>
                                <h4>ARQMED Studio</h4>
                                <p>Editor web y app nativa para Android de presupuestos FIEBDC-3 (.BC3). Parser en Python (0 dependencias), recálculo en cascada de mediciones y exportador a SQLite/JSON/CSV.</p>
                            </div>
                        </div>

                        <div class="event-item">
                            <span class="event-dot cyan"></span>
                            <div class="event-meta">
                                <span class="event-date">ACTUALIDAD</span>
                                <h4>Trabajo de Fin de Grado (TFG) — SecureChain</h4>
                                <p>Investigación en resolución de dependencias multiecosistema mediante Z3 SMT Solver, análisis AST de Go y pipelines de datos con Dagster y FastAPI.</p>
                            </div>
                        </div>

                        <div class="event-item">
                            <span class="event-dot cyan"></span>
                            <div class="event-meta">
                                <span class="event-date">SEP 2024 – JUN 2025</span>
                                <h4>Estancia Internacional Erasmus+ — Alemania</h4>
                                <p>Inmersión académica internacional en inglés técnico. Desarrollo de software distribuido y colaboración con equipos de investigación.</p>
                            </div>
                        </div>

                        <div class="event-item">
                            <span class="event-dot"></span>
                            <div class="event-meta">
                                <span class="event-date">2022 – 2026</span>
                                <h4>Grado en Ingeniería Informática — ETSII Univ. Sevilla</h4>
                                <p>Ingeniería de software, desarrollo frontend y móvil, bases de datos relacionales, sistemas operativos (kernel/POSIX), redes y arquitectura de computadores.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Right Column: Philosophy, Method & Languages -->
            <section class="profile-main-content reveal-up">
                <!-- Philosophy -->
                <div class="narrative-card spotlight-card">
                    <span class="badge-chip emerald">VISIÓN DE INGENIERÍA</span>
                    <h2>Software integral sin intermediarios</h2>
                    <blockquote>
                        "Un buen ingeniero no se limita a una sola etiqueta. Si hace falta una interfaz reactiva, se diseña; si se necesita una app para tablet a pie de obra, se compila; y si hay que auditar el rendimiento o la seguridad del backend en el kernel, se depura a bajo nivel."
                    </blockquote>
                    <p>
                        Me apasiona crear herramientas funcionales y completas. Desde proyectos industriales como <strong>ARQMED Studio</strong> (donde combiné frontend SPA, APK móvil Android y un parser bidireccional en Python con 0 dependencias) hasta plataformas analíticas como <strong>SecureChain</strong> o motores de telemetría de sistemas como <strong>Aegis Sentinel</strong>.
                    </p>
                </div>

                <!-- Technical Pillars -->
                <div class="pillars-grid">
                    <div class="pillar-card spotlight-card">
                        <span class="pillar-num">01</span>
                        <h3>Full-Stack & Mobile</h3>
                        <p>Diseño y construcción de aplicaciones web completas (SPAs con IndexedDB), APIs REST concurrentes y aplicaciones móviles para Android orientadas a resolver problemas del mundo real.</p>
                    </div>

                    <div class="pillar-card spotlight-card">
                        <span class="pillar-num">02</span>
                        <h3>Bases de Datos & Automatizaciones</h3>
                        <p>Modelado de esquemas eficientes en SQLite y PostgreSQL, pipelines de datos con Dagster y scripts CLI que automatizan tareas complejas sin fricción.</p>
                    </div>

                    <div class="pillar-card spotlight-card">
                        <span class="pillar-num">03</span>
                        <h3>Lógica Formal & Algoritmos</h3>
                        <p>Uso de herramientas avanzadas de computación (como el solucionador Z3) para resolver problemas donde las heurísticas tradicionales fallan.</p>
                    </div>

                    <div class="pillar-card spotlight-card">
                        <span class="pillar-num">04</span>
                        <h3>Sistemas & Seguridad Nativa</h3>
                        <p>Comprensión profunda de llamadas al sistema Linux, memoria y paquetes de red para diseñar software que es inherentemente robusto y seguro desde su concepción.</p>
                    </div>
                </div>

                <!-- Languages -->
                <div class="languages-block spotlight-card">
                    <h3>Idiomas & Comunicación</h3>
                    <div class="lang-row">
                        <div class="lang-item">
                            <span class="lang-title">Español</span>
                            <span class="badge-chip emerald">Nativo</span>
                            <p class="lang-desc">Comunicación clara, trabajo en equipo y redacción técnica de especificaciones.</p>
                        </div>
                        <div class="lang-item">
                            <span class="lang-title">Inglés</span>
                            <span class="badge-chip cyan">Profesional (B2 / C1)</span>
                            <p class="lang-desc">Capacidad demostrada en entorno académico en Alemania, documentación y código internacional.</p>
                        </div>
                        <div class="lang-item">
                            <span class="lang-title">Alemán</span>
                            <span class="badge-chip">Básico (A2)</span>
                            <p class="lang-desc">Competencia comunicativa básica adquirida durante la estancia Erasmus.</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <Footer />

    <style>
        .layout-wrapper {
            padding-top: clamp(6.5rem, 14vh, 9.5rem);
            padding-bottom: var(--macro-gap);
        }

        .page-top-nav { margin-bottom: 2rem; }
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-family: var(--font-mono);
            font-size: 0.82rem;
            color: var(--text-muted);
            transition: color 0.2s ease;
        }
        .back-link:hover { color: var(--accent-cyan); }

        .page-header { max-width: 900px; margin-bottom: 3rem; }
        .page-title { margin-top: 0.75rem; margin-bottom: 1.25rem; font-size: clamp(2.4rem, 5.5vw, 4.2rem); line-height: 1.1; }
        .text-cyan { color: var(--accent-cyan); }
        .page-desc { font-size: 1.05rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 2rem; }

        .profile-actions-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .arrow-up { font-size: 0.8rem; }

        .profile-split-layout {
            display: grid;
            grid-template-columns: 1fr 1.4fr;
            gap: 2rem;
        }

        .profile-aside {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .spec-card {
            padding: 1.75rem;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .spec-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .spec-title {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            font-weight: 600;
        }

        .spec-list {
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
        }

        .spec-item {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
        }

        .spec-k {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        .spec-v {
            font-size: 0.88rem;
            color: var(--text-primary);
        }

        .timeline-box {
            padding: 1.75rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .timeline-heading {
            font-size: 1.15rem;
            margin: 0;
        }

        .timeline-events {
            display: flex;
            flex-direction: column;
            gap: 1.75rem;
            position: relative;
            padding-left: 1.25rem;
            border-left: 1px solid var(--border-medium);
        }

        .event-item {
            position: relative;
        }

        .event-dot {
            position: absolute;
            left: -1.6rem;
            top: 0.35rem;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--text-muted);
            border: 2px solid var(--bg-surface);
        }

        .event-dot.emerald { background: var(--accent-emerald); }
        .event-dot.cyan { background: var(--accent-cyan); }

        .event-meta {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .event-date {
            font-family: var(--font-mono);
            font-size: 0.68rem;
            color: var(--text-muted);
            letter-spacing: 0.05em;
        }

        .event-meta h4 {
            font-size: 0.98rem;
            margin: 0;
            color: var(--text-primary);
        }

        .event-meta p {
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.5;
            margin: 0;
        }

        .profile-main-content {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .narrative-card {
            padding: 2.25rem;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .narrative-card h2 {
            font-size: 1.8rem;
            margin: 0;
        }

        .narrative-card blockquote {
            font-style: italic;
            border-left: 2px solid var(--accent-cyan);
            padding-left: 1.25rem;
            color: var(--text-primary);
            font-size: 1.05rem;
            line-height: 1.6;
            margin: 0;
        }

        .narrative-card p {
            font-size: 0.98rem;
            line-height: 1.7;
            margin: 0;
        }

        .narrative-card strong {
            color: var(--text-primary);
        }

        .pillars-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }

        .pillar-card {
            padding: 1.75rem;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .pillar-num {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--accent-cyan);
        }

        .pillar-card h3 {
            font-size: 1.15rem;
            margin: 0;
        }

        .pillar-card p {
            font-size: 0.88rem;
            line-height: 1.6;
            margin: 0;
        }

        .languages-block {
            padding: 2rem;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .languages-block h3 {
            font-size: 1.25rem;
            margin: 0;
        }

        .lang-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.25rem;
        }

        .lang-item {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .lang-title {
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 1rem;
            color: var(--text-primary);
        }

        .lang-desc {
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.4;
            margin: 0;
        }

        @media (max-width: 960px) {
            .profile-split-layout { grid-template-columns: 1fr; }
            .pillars-grid { grid-template-columns: 1fr; }
            .lang-row { grid-template-columns: 1fr; }
        }
    </style>
</body>
</html>
