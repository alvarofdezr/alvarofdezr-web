---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Stack & Certificaciones | Álvaro Fernández Ramos";
const description = "Arsenal tecnológico, entornos de desarrollo, aplicaciones y progreso en certificaciones de ciberseguridad.";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <BaseHead title={title} description={description} />
</head>
<body>
    <div class="mesh-bg"></div>
    <Header />

    <main class="container layout-wrapper">
        <a href="/" class="btn-magnetic back-btn reveal-up">
            <div class="icon-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" d="M216 128H40m72-72l-72 72l72 72"/></svg>
            </div>
            Volver
        </a>

        <header class="page-header reveal-up" style="transition-delay: 0.1s;">
            <span class="eyebrow">Arsenal Técnico</span>
            <h1 class="page-title">
                Stack y <br>
                <span class="text-accent">Herramientas.</span>
            </h1>
            <p class="page-desc">
                Tecnologías principales, entornos de despliegue y herramientas aplicadas a la auditoría de seguridad, monitorización y arquitecturas Zero-Trust.
            </p>
        </header>

        <section class="stack-section reveal-up" style="transition-delay: 0.2s;">
            <h2 class="section-title">Tecnologías Core</h2>
            <div class="bento-dense">
                <!-- Go Card -->
                <div class="bento-card bezel-outer tech-go span-row-2">
                    <div class="bezel-inner">
                        <div class="card-head">
                            <div class="icon-box"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="m9 15 2 2 4-4"></path></svg></div>
                            <h3>Go (Golang)</h3>
                        </div>
                        <p>Desarrollo de herramientas de seguridad de bajo nivel, análisis de dependencias de alta concurrencia y despliegues estáticos rápidos.</p>
                        <div class="tags"><span>Goroutines</span><span>AST Parsing</span></div>
                    </div>
                </div>

                <!-- Python Card -->
                <div class="bento-card bezel-outer tech-py span-row-2">
                    <div class="bezel-inner">
                        <div class="card-head">
                            <div class="icon-box"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"></path><path d="m6 8-4 4 4 4"></path><path d="m14.5 4-5 16"></path></svg></div>
                            <h3>Python</h3>
                        </div>
                        <p>Scripting ofensivo, automatización defensiva, análisis de malware y desarrollo de agentes EDR multiplataforma.</p>
                        <div class="tags"><span>FastAPI</span><span>uv</span><span>Pytest</span></div>
                    </div>
                </div>

                <!-- Containers Card -->
                <div class="bento-card bezel-outer tech-docker span-col-2">
                    <div class="bezel-inner">
                        <div class="card-head">
                            <div class="icon-box"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M8 12h8"></path><path d="M12 8v8"></path></svg></div>
                            <h3>Contenedores & Sandboxing</h3>
                        </div>
                        <p>Virtualización ligera y orquestación para aislar servicios, pruebas de concepto y arquitecturas de microservicios seguras.</p>
                        <div class="tags"><span>Docker</span><span>Compose</span></div>
                    </div>
                </div>
            </div>
        </section>

        <section class="stack-section reveal-up">
            <h2 class="section-title">Especialización & Dominio</h2>
            <div class="bento-dense spec-grid">
                
                <div class="bento-card bezel-outer span-col-2">
                    <div class="bezel-inner">
                        <h3>Análisis de Red y Detección</h3>
                        <p>Inspección profunda de paquetes (DPI), enumeración de servicios, vulnerabilidades activas y sistemas NIDS.</p>
                        <div class="tags"><span>Wireshark</span><span>Nmap</span><span>Suricata</span><span>Lynis</span></div>
                    </div>
                </div>

                <div class="bento-card bezel-outer span-col-2">
                    <div class="bezel-inner">
                        <h3>Análisis de Composición (SCA)</h3>
                        <p>Auditoría cruzada de dependencias, resolución de restricciones y vulnerabilidades en la cadena de suministro en múltiples lenguajes.</p>
                        <div class="tags"><span>pyproject.toml</span><span>go.mod</span><span>Cargo</span><span>npm</span></div>
                    </div>
                </div>

                <div class="bento-card bezel-outer">
                    <div class="bezel-inner">
                        <h3>Auditoría Lógica (SAST)</h3>
                        <p>Validación formal de vulnerabilidades en la lógica de negocio.</p>
                        <div class="tags"><span>Z3 Prover</span><span>Bandit</span></div>
                    </div>
                </div>

                <div class="bento-card bezel-outer">
                    <div class="bezel-inner">
                        <h3>Persistencia & Grafos</h3>
                        <p>Modelado relacional y grafos para correlación de eventos.</p>
                        <div class="tags"><span>Neo4j</span><span>MongoDB</span></div>
                    </div>
                </div>

            </div>
        </section>

        <section class="stack-section reveal-up">
            <h2 class="section-title">Certificaciones</h2>
            <div class="cert-grid">
                
                <div class="cert-card bezel-outer">
                    <div class="bezel-inner">
                        <div class="cert-header">
                            <span class="pill-badge accent-badge">Planificado</span>
                        </div>
                        <h3>eJPT — Junior Penetration Tester</h3>
                        <p>Consolidación práctica de bases de seguridad ofensiva, enumeración activa y auditoría de redes lógicas.</p>
                    </div>
                </div>

                <div class="cert-card bezel-outer">
                    <div class="bezel-inner">
                        <div class="cert-header">
                            <span class="pill-badge accent-badge">Planificado</span>
                        </div>
                        <h3>OSCP — Offensive Security</h3>
                        <p>Preparación orientada a la explotación manual avanzada, escalada de privilegios y metodologías estandarizadas.</p>
                    </div>
                </div>

                <div class="cert-card bezel-outer">
                    <div class="bezel-inner">
                        <div class="cert-header">
                            <span class="pill-badge success-badge">Acreditado</span>
                        </div>
                        <h3>Cambridge B2 English</h3>
                        <p>Competencia profesional fluida. Idioma vehicular para lectura de especificaciones (CVEs) y redacción de reportes.</p>
                    </div>
                </div>

            </div>
        </section>

    </main>

    <Footer />

    <style>
        .layout-wrapper {
            padding-top: clamp(8rem, 20vh, 14rem);
        }

        .back-btn {
            background: transparent;
            color: var(--text-secondary);
            padding-left: 0.5rem;
            margin-bottom: 3rem;
            flex-direction: row-reverse;
        }

        .back-btn .icon-wrapper { background: transparent; }
        .back-btn:hover { background: rgba(255,255,255,0.05); color: var(--text-primary); }
        .back-btn:hover .icon-wrapper { transform: translateX(-4px); }

        .page-header {
            max-width: 800px;
            margin-bottom: 6rem;
        }

        .page-title {
            color: var(--text-primary);
            font-size: clamp(3.5rem, 6vw, 5rem);
            margin-bottom: 1.5rem;
            line-height: 1.05;
        }

        .text-accent {
            color: var(--accent);
            background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .page-desc {
            font-size: 1.15rem;
            color: var(--text-secondary);
            margin-bottom: 3rem;
            line-height: 1.8;
            max-width: 650px;
        }

        .stack-section {
            margin-bottom: 6rem;
        }

        .section-title {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .section-title::after {
            content: '';
            height: 1px;
            flex-grow: 1;
            background: var(--border-outer);
        }

        /* ── Bento Dense ── */
        .bento-dense {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-auto-rows: minmax(180px, auto);
            gap: 1.5rem;
        }

        .spec-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .bento-card .bezel-inner {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding: 2.5rem;
        }

        .span-row-2 { grid-row: span 2; }
        .span-col-2 { grid-column: span 2; }
        
        .tech-go { grid-column: span 2; }
        .tech-py { grid-column: span 2; }
        .tech-docker { grid-column: span 4; }

        .card-head {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 0.5rem;
        }

        .icon-box {
            width: 48px;
            height: 48px;
            background: var(--surface-outer);
            border: 1px solid var(--border-inner);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
        }

        .bento-card h3 {
            font-size: 1.6rem;
            color: var(--text-primary);
            margin: 0;
        }

        .bento-card p {
            font-size: 1.05rem;
            color: var(--text-secondary);
            line-height: 1.6;
            margin: 0;
            flex-grow: 1;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: auto;
            padding-top: 1rem;
        }

        .tags span {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-muted);
            padding: 0.25rem 0.75rem;
            border: 1px solid var(--border-outer);
            border-radius: 4px;
        }

        /* ── Certifications ── */
        .cert-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        .cert-card .bezel-inner {
            padding: 2.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .cert-header {
            margin-bottom: 0.5rem;
        }

        .pill-badge {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            padding: 0.2rem 0.8rem;
            border-radius: var(--radius-pill);
            letter-spacing: 0.05em;
            display: inline-block;
        }

        .accent-badge {
            background: var(--accent-glow);
            color: var(--accent);
            border: 1px solid var(--accent);
        }

        .success-badge {
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.4);
        }

        .cert-card h3 {
            font-size: 1.4rem;
            color: var(--text-primary);
            margin: 0;
        }

        .cert-card p {
            font-size: 1rem;
            color: var(--text-secondary);
            line-height: 1.6;
            margin: 0;
        }

        @media (max-width: 900px) {
            .bento-dense { grid-template-columns: 1fr; }
            .tech-go, .tech-py, .tech-docker, .span-row-2, .span-col-2 {
                grid-column: span 1;
                grid-row: auto;
            }
            .spec-grid { grid-template-columns: 1fr; }
        }
    </style>
</body>
</html>