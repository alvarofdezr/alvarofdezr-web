---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Stack y Arsenal Técnico | Álvaro Fernández Ramos";
const description = "Arsenal tecnológico: desarrollo web, aplicaciones Android, backend, bases de datos, automatizaciones y sistemas.";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <BaseHead title={title} description={description} />
</head>
<body>
    <Header />

    <main class="container layout-wrapper">
        <div class="page-top-nav reveal-up">
            <a href="/" class="back-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
                <span>Volver al inicio</span>
            </a>
        </div>

        <header class="page-header reveal-up">
            <div class="badge-chip emerald">ARSENAL TÉCNICO & DOMINIO</div>
            <h1 class="page-title">
                Tecnologías y <br>
                <span class="text-cyan" data-scramble="entornos de desarrollo.">entornos de desarrollo.</span>
            </h1>
            <p class="page-desc">
                Herramientas y tecnologías seleccionadas para construir software completo: desde interfaces web y móviles para usuario final hasta motores de cálculo de bajo nivel, bases de datos y tuberías de automatización.
            </p>
        </header>

        <!-- Search & Filter Controls -->
        <div class="arsenal-controls reveal-up">
            <div class="search-box spotlight-card">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input id="stack-search" type="text" placeholder="Filtrar por tecnología, framework o herramienta..." autocomplete="off">
            </div>

            <div class="stack-filters">
                <button class="filter-chip active" data-filter="all">Todas (12)</button>
                <button class="filter-chip" data-filter="web-mobile">Web, Android & DB</button>
                <button class="filter-chip" data-filter="core">Lenguajes Backend</button>
                <button class="filter-chip" data-filter="systems">Sistemas & Lógica Formal</button>
                <button class="filter-chip" data-filter="security">Seguridad & Redes</button>
            </div>
        </div>

        <!-- Arsenal Grid -->
        <div class="arsenal-cards-grid" id="arsenal-cards-container">
            <!-- Web & Frontend SPA -->
            <div class="stack-card spotlight-card" data-category="web-mobile" data-keywords="web frontend javascript spa indexeddb css ui ux html5 arqmed">
                <div class="card-top">
                    <div class="tech-icon-title">
                        <span class="tech-symbol">Web</span>
                        <h3>Desarrollo Web & SPAs</h3>
                    </div>
                    <span class="badge-chip emerald">Frontend</span>
                </div>
                <p class="tech-description">
                    Construcción de aplicaciones web interactivas (SPAs) con JavaScript moderno, gestión de estado en cliente, persistencia en IndexedDB, arquitecturas modulares y diseño UI/UX responsivo (como el editor interactivo de ARQMED Studio).
                </p>
                <div class="tag-list">
                    <span>JavaScript ES6+</span><span>IndexedDB</span><span>Web APIs</span><span>CSS Architecture</span>
                </div>
            </div>

            <!-- Android Mobile -->
            <div class="stack-card spotlight-card" data-category="web-mobile" data-keywords="android apk tablet mobile app aplicacion movil arqmed">
                <div class="card-top">
                    <div class="tech-icon-title">
                        <span class="tech-symbol">And</span>
                        <h3>Desarrollo Android</h3>
                    </div>
                    <span class="badge-chip emerald">Mobile</span>
                </div>
                <p class="tech-description">
                    Empaquetado y distribución de aplicaciones nativas Android (APK) orientadas a tablets para uso en movilidad y pie de obra, con soporte táctil, almacenamiento local desacoplado y rendimiento optimizado.
                </p>
                <div class="tag-list">
                    <span>Android APK</span><span>Tablet UI</span><span>Offline First</span><span>Mobile Packaging</span>
                </div>
            </div>

            <!-- Databases & SQLite -->
            <div class="stack-card spotlight-card" data-category="web-mobile" data-keywords="sqlite databases sql bases de datos esquemas json csv orm persistencia">
                <div class="card-top">
                    <div class="tech-icon-title">
                        <span class="tech-symbol">SQL</span>
                        <h3>Bases de Datos & SQLite</h3>
                    </div>
                    <span class="badge-chip cyan">Datos</span>
                </div>
                <p class="tech-description">
                    Modelado relacional estricto, consultas optimizadas, exportaciones masivas a SQLite y manipulación de datos tabulares en formatos JSON y CSV para interoperabilidad completa de sistemas.
                </p>
                <div class="tag-list">
                    <span>SQLite3</span><span>Relational Schemas</span><span>Data Serialization</span><span>JSON / CSV</span>
                </div>
            </div>

            <!-- Python & Automation -->
            <div class="stack-card spotlight-card" data-category="core" data-keywords="python automatizaciones backend dagster fastapi cli bc3 parser">
                <div class="card-top">
                    <div class="tech-icon-title">
                        <span class="tech-symbol">Py</span>
                        <h3>Python & Automatizaciones</h3>
                    </div>
                    <span class="badge-chip cyan">Avanzado</span>
                </div>
                <p class="tech-description">
                    Desarrollo de parsers de alta fidelidad con 0 dependencias externas (Arqmed), utilidades CLI automatizadas, APIs asíncronas con FastAPI y pipelines de datos complejos orquestados con Dagster.
                </p>
                <div class="tag-list">
                    <span>FastAPI</span><span>Dagster</span><span>CLI Automation</span><span>Zero Runtime Deps</span>
                </div>
            </div>

            <!-- Go -->
            <div class="stack-card spotlight-card" data-category="core" data-keywords="go golang concurrencia ast goroutines ares securechain">
                <div class="card-top">
                    <div class="tech-icon-title">
                        <span class="tech-symbol">Go</span>
                        <h3>Go (Golang)</h3>
                    </div>
                    <span class="badge-chip cyan">Avanzado</span>
                </div>
                <p class="tech-description">
                    Construcción de herramientas concurrentes de alto rendimiento (Ares), escaneo masivo paralelo mediante canales y goroutines, y parsing de árboles sintácticos (AST) de código fuente en SecureChain.
                </p>
                <div class="tag-list">
                    <span>Goroutines</span><span>AST Parsing</span><span>Raw Sockets</span><span>go.mod Parser</span>
                </div>
            </div>

            <!-- C / POSIX -->
            <div class="stack-card spotlight-card" data-category="systems" data-keywords="c c99 posix linux syscalls memoria heap stack punteros">
                <div class="card-top">
                    <div class="tech-icon-title">
                        <span class="tech-symbol">C</span>
                        <h3>C (C99 / POSIX)</h3>
                    </div>
                    <span class="badge-chip cyan">Sistemas</span>
                </div>
                <p class="tech-description">
                    Control absoluto del layout de memoria, punteros, manejo directo de llamadas al sistema (syscalls) en Linux y depuración técnica mediante GDB y Valgrind.
                </p>
                <div class="tag-list">
                    <span>Linux Syscalls</span><span>GDB</span><span>Memory Layout</span><span>Valgrind</span>
                </div>
            </div>

            <!-- Z3 Theorem Prover -->
            <div class="stack-card spotlight-card" data-category="systems" data-keywords="z3 smt sat logica formal formal verification solver tfg">
                <div class="card-top">
                    <div class="tech-icon-title">
                        <span class="tech-symbol">Z3</span>
                        <h3>Z3 SMT Solver</h3>
                    </div>
                    <span class="badge-chip emerald">Lógica Formal</span>
                </div>
                <p class="tech-description">
                    Modelado de restricciones complejas de paquetes y dependencias en forma de fórmulas SAT/SMT para obtener resoluciones deterministas matemáticamente verificadas en mi TFG.
                </p>
                <div class="tag-list">
                    <span>SMT Solving</span><span>Boolean Logic</span><span>SAT Solvers</span>
                </div>
            </div>

            <!-- Docker & Sandboxing -->
            <div class="stack-card spotlight-card" data-category="web-mobile" data-keywords="docker contenedores sandbox compose cgroups namespaces virtualizacion">
                <div class="card-top">
                    <div class="tech-icon-title">
                        <span class="tech-symbol">Doc</span>
                        <h3>Docker & Sandboxing</h3>
                    </div>
                    <span class="badge-chip emerald">Infraestructura</span>
                </div>
                <p class="tech-description">
                    Aislamiento y contenedorización de servicios, pruebas de concepto reproducibles y ejecución hermética de procesos en entornos aislados con control estricto de recursos.
                </p>
                <div class="tag-list">
                    <span>Namespaces</span><span>cgroups</span><span>Docker Compose</span><span>Testing Labs</span>
                </div>
            </div>

            <!-- Wireshark & Redes -->
            <div class="stack-card spotlight-card" data-category="security" data-keywords="wireshark pcap tcpdump dpi redes protocolos analisis">
                <div class="card-top">
                    <div class="tech-icon-title">
                        <span class="tech-symbol">Net</span>
                        <h3>Redes & Análisis de Tráfico</h3>
                    </div>
                    <span class="badge-chip amber">Protocolos</span>
                </div>
                <p class="tech-description">
                    Inspección profunda de paquetes (DPI), análisis de capturas PCAP con Wireshark/tcpdump, validación de handshakes TLS y monitorización de tráfico en red.
                </p>
                <div class="tag-list">
                    <span>Wireshark</span><span>PCAP</span><span>TCP/IP</span><span>TLS Handshake</span>
                </div>
            </div>

            <!-- YARA & EDR -->
            <div class="stack-card spotlight-card" data-category="security" data-keywords="yara edr malware aegis basilisk firmas deteccion">
                <div class="card-top">
                    <div class="tech-icon-title">
                        <span class="tech-symbol">Yar</span>
                        <h3>Motores EDR & Reglas YARA</h3>
                    </div>
                    <span class="badge-chip amber">Seguridad</span>
                </div>
                <p class="tech-description">
                    Desarrollo de agentes de detección para endpoints, monitorización de la tabla de procesos y escaneo de firmas de binarios en memoria mediante reglas YARA integradas.
                </p>
                <div class="tag-list">
                    <span>Host Telemetry</span><span>FIM</span><span>In-Memory Scan</span><span>EDR Agents</span>
                </div>
            </div>
        </div>

        <!-- Academic & Qualifications Section -->
        <section class="cert-section reveal-up">
            <div class="section-header">
                <div>
                    <span class="badge-chip cyan">TRAYECTORIA & FORMACIÓN</span>
                    <h2 class="section-title">Formación Académica</h2>
                </div>
            </div>

            <div class="cert-grid">
                <div class="cert-card spotlight-card">
                    <div class="cert-badge-row">
                        <span class="badge-chip emerald">Académico // En Curso</span>
                        <span class="cert-year">2022 - 2026</span>
                    </div>
                    <h3>Grado en Ingeniería Informática</h3>
                    <p class="cert-institution">ETSII — Universidad de Sevilla</p>
                    <p class="cert-desc">
                        Formación completa en ingeniería del software: desarrollo web y móvil, diseño de bases de datos, algoritmos, sistemas distribuidos y arquitectura de computadores.
                    </p>
                </div>

                <div class="cert-card spotlight-card">
                    <div class="cert-badge-row">
                        <span class="badge-chip cyan">Internacional</span>
                        <span class="cert-year">2024 - 2025</span>
                    </div>
                    <h3>Estancia Académica Erasmus+</h3>
                    <p class="cert-institution">Alemania</p>
                    <p class="cert-desc">
                        Inmersión técnica en inglés con enfoque en sistemas concurrentes, metodologías de ingeniería ágil y colaboración en equipos de desarrollo europeos.
                    </p>
                </div>
            </div>
        </section>
    </main>

    <Footer />

    <style>
        .layout-wrapper { padding-top: clamp(6.5rem, 14vh, 9.5rem); padding-bottom: var(--macro-gap); }
        .page-top-nav { margin-bottom: 2rem; }
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-family: var(--font-mono);
            font-size: 0.82rem;
            color: var(--text-muted);
            transition: color 0.2s ease;
        }
        .back-link:hover { color: var(--accent-cyan); }

        .page-header { max-width: 900px; margin-bottom: 2.5rem; }
        .page-title { margin-top: 0.75rem; margin-bottom: 1.25rem; font-size: clamp(2.4rem, 5.5vw, 4.2rem); line-height: 1.1; }
        .text-cyan { color: var(--accent-cyan); }
        .page-desc { font-size: 1.05rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 2rem; }

        .arsenal-controls { display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 2.5rem; }
        .search-box {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1.25rem;
            background: var(--bg-surface);
            border: 1px solid var(--border-medium);
            border-radius: var(--radius-sm);
        }
        .search-box input {
            flex: 1;
            background: transparent;
            border: none;
            outline: none;
            font-family: var(--font-body);
            font-size: 0.95rem;
            color: var(--text-primary);
        }
        .search-box input::placeholder { color: var(--text-muted); }

        .stack-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
        .filter-chip {
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            color: var(--text-secondary);
            font-family: var(--font-mono);
            font-size: 0.78rem;
            padding: 0.35rem 0.85rem;
            border-radius: var(--radius-pill);
            cursor: pointer;
            transition: transform 140ms var(--ease-out), background-color 140ms var(--ease-out), border-color 140ms var(--ease-out), color 140ms var(--ease-out);
        }
        .filter-chip:hover { border-color: var(--border-medium); color: var(--text-primary); }
        .filter-chip:active { transform: scale(0.95); }
        .filter-chip.active {
            background: var(--text-primary);
            color: var(--bg-base);
            border-color: var(--text-primary);
            font-weight: 600;
        }

        .arsenal-cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: var(--macro-gap);
        }

        .stack-card {
            padding: 1.75rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 1.25rem;
        }

        .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; }
        .tech-icon-title { display: flex; align-items: center; gap: 0.6rem; }
        .tech-symbol {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--accent-cyan);
            background: rgba(0, 240, 255, 0.08);
            border: 1px solid rgba(0, 240, 255, 0.2);
            padding: 0.2rem 0.45rem;
            border-radius: 4px;
        }
        .tech-icon-title h3 { font-size: 1.15rem; margin: 0; }
        .tech-description { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; margin: 0; flex: 1; }
        .tag-list { display: flex; flex-wrap: wrap; gap: 0.4rem; }
        .tag-list span {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            padding: 0.15rem 0.45rem;
            border-radius: 4px;
            background: var(--bg-surface-elevated);
            border: 1px solid var(--border-subtle);
            color: var(--text-muted);
        }

        .cert-section { border-top: 1px solid var(--border-subtle); padding-top: calc(var(--macro-gap) * 0.75); }
        .section-header { margin-bottom: 2rem; }
        .section-title { font-size: clamp(1.8rem, 3.5vw, 2.5rem); margin-top: 0.5rem; }

        .cert-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
        .cert-card { padding: 2rem; display: flex; flex-direction: column; gap: 0.75rem; }
        .cert-badge-row { display: flex; align-items: center; justify-content: space-between; }
        .cert-year { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); }
        .cert-card h3 { font-size: 1.25rem; margin: 0; }
        .cert-institution { font-family: var(--font-mono); font-size: 0.82rem; color: var(--accent-cyan); margin: 0; }
        .cert-desc { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; margin: 0; }

        @media (max-width: 900px) { .cert-grid { grid-template-columns: 1fr; } }
    </style>

    <script>
        function setupStackPage() {
            const searchInput = document.getElementById('stack-search') as HTMLInputElement;
            const filterChips = document.querySelectorAll('.filter-chip');
            const cards = document.querySelectorAll<HTMLElement>('.stack-card');

            let currentFilter = 'all';

            function updateCards() {
                const query = searchInput?.value.toLowerCase().trim() || '';
                cards.forEach((card) => {
                    const category = card.getAttribute('data-category');
                    const keywords = (card.getAttribute('data-keywords') || '').toLowerCase();
                    const text = card.textContent?.toLowerCase() || '';

                    const matchesCat = currentFilter === 'all' || category === currentFilter;
                    const matchesQuery = !query || keywords.includes(query) || text.includes(query);

                    if (matchesCat && matchesQuery) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
            }

            searchInput?.addEventListener('input', updateCards);

            filterChips.forEach((chip) => {
                chip.addEventListener('click', () => {
                    currentFilter = chip.getAttribute('data-filter') || 'all';
                    filterChips.forEach((c) => c.classList.remove('active'));
                    chip.classList.add('active');
                    updateCards();
                });
            });
        }

        setupStackPage();
        document.addEventListener('astro:after-swap', setupStackPage);
    </script>
</body>
</html>
