---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectVignettes from '../../components/ProjectVignettes.astro';

const title = "Projects & Case Studies | Álvaro Fernández Ramos";
const description = "Software engineering projects: full-stack web apps, Android APKs, parsers, EDR agents, offensive tooling, and formal logic.";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead title={title} description={description} />
</head>
<body>
    <Header />

    <main class="container layout-wrapper">
        <div class="page-top-nav reveal-up">
            <a href="/en" class="back-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
                <span>Back to home</span>
            </a>
        </div>

        <header class="page-header reveal-up">
            <div class="badge-chip cyan">TECHNICAL CASE STUDIES</div>
            <h1 class="page-title">
                Projects & <br>
                <span class="text-cyan" data-scramble="systems development.">systems development.</span>
            </h1>
            <p class="page-desc">
                Comprehensive software solutions: from production-grade web SPAs and Android tablet apps to high-throughput parsers, system telemetry collectors, and formal verification with logic solvers.
            </p>
        </header>

        <ProjectVignettes lang="en" />
    </main>

    <Footer />

    <style>
        .layout-wrapper {
            padding-top: clamp(6.5rem, 14vh, 9.5rem);
            padding-bottom: var(--macro-gap);
        }

        .page-top-nav { margin-bottom: 2rem; }
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-family: var(--font-mono);
            font-size: 0.82rem;
            color: var(--text-muted);
            transition: color 140ms var(--ease-out);
        }
        .back-link:hover { color: var(--accent-cyan); }

        .page-header {
            margin-bottom: 2.75rem;
            max-width: 900px;
        }
        .page-title {
            margin-top: 1rem;
            margin-bottom: 1.25rem;
            font-size: clamp(2.4rem, 5.5vw, 4rem);
        }
        .text-cyan { color: var(--accent-cyan); }
        .page-desc {
            font-size: 1.15rem;
            color: var(--text-secondary);
            max-width: 720px;
            margin-bottom: 0;
        }
    </style>
</body>
</html>
