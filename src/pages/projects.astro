---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectVignettes from '../components/ProjectVignettes.astro';

const title = "Proyectos & Casos de Estudio | Álvaro Fernández Ramos";
const description = "Proyectos de desarrollo de software: aplicaciones web, Android, parsers, EDRs, herramientas ofensivas y lógica formal.";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <BaseHead title={title} description={description} />
</head>
<body>
    <Header />

    <main class="container layout-wrapper">
        <div class="page-top-nav reveal-up">
            <a href="/" class="back-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
                <span>Volver al inicio</span>
            </a>
        </div>

        <header class="page-header reveal-up">
            <div class="badge-chip cyan">CASOS DE ESTUDIO TÉCNICOS</div>
            <h1 class="page-title">
                Proyectos y <br>
                <span class="text-cyan" data-scramble="desarrollo de sistemas.">desarrollo de sistemas.</span>
            </h1>
            <p class="page-desc">
                Soluciones integrales de software: desde aplicaciones completas para web y Android hasta parsers de alta fidelidad, motores de telemetría de sistemas y verificación formal con solucionadores lógicos.
            </p>
        </header>

        <ProjectVignettes lang="es" />
    </main>

    <Footer />

    <style>
        .layout-wrapper {
            padding-top: clamp(6.5rem, 14vh, 9.5rem);
            padding-bottom: var(--macro-gap);
        }

        .page-top-nav { margin-bottom: 2rem; }
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-family: var(--font-mono);
            font-size: 0.82rem;
            color: var(--text-muted);
            transition: color 140ms var(--ease-out);
        }
        .back-link:hover { color: var(--accent-cyan); }

        .page-header {
            margin-bottom: 2.75rem;
            max-width: 900px;
        }
        .page-title {
            margin-top: 1rem;
            margin-bottom: 1.25rem;
            font-size: clamp(2.4rem, 5.5vw, 4rem);
        }
        .text-cyan { color: var(--accent-cyan); }
        .page-desc {
            font-size: 1.15rem;
            color: var(--text-secondary);
            max-width: 720px;
            margin-bottom: 0;
        }
    </style>
</body>
</html>
