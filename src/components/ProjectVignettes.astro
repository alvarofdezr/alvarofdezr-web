                    </div>
                </div>

                <div class="view-tabs" role="tablist">
                    <button class="tab-btn active" data-tab="overview">{isEn ? 'Overview' : 'Ficha Técnica'}</button>
                    <button class="tab-btn" data-tab="architecture">{isEn ? 'Architecture & Flow' : 'Arquitectura & Flujo'}</button>
