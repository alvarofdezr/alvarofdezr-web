---
interface Props {
    lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEn = lang === 'en';

const projects = [
    {
        id: 'arqmed',
        num: '01',
        title: 'ARQMED Studio',
        logoImg: '/logos/arqmed.svg',
        categoryFilter: 'web-mobile',
        categoryTag: isEn ? 'Latest // Full-Stack & Android' : 'Último Proyecto // Full-Stack & Android',
        categoryChip: 'emerald',
        badgeFront: isEn ? 'Latest' : 'Lanzamiento',
        sub: 'Web SPA & Android APK',
        tagline: isEn 
            ? 'Bidirectional parser and web editor + native Android tablet app for FIEBDC-3 (.BC3) architectural bill of quantities.'
            : 'Parser bidireccional y editor web + app nativa Android para presupuestos de construcción FIEBDC-3 (.BC3).',
        specs: [
            { k: isEn ? 'Core' : 'Núcleo', v: 'Python (0 deps)' },
            { k: isEn ? 'Platform' : 'Plataforma', v: 'Web + Android' },
            { k: 'Storage', v: 'SQLite / IndexedDB' }
        ],
        github: 'https://github.com/alvarofdezr/Arqmed',
        extraLink: {
            url: 'https://github.com/alvarofdezr/Arqmed/releases',
            text: isEn ? 'Android APK' : 'Android APK'
        },
        overview: isEn
            ? 'Full-stack engineering modernizing construction budget tooling. Features a zero-dependency Python parser (UTF-8, Windows-1252, and CP850), structured exporter to SQLite, JSON, and CSV, an interactive web editor with IndexedDB persistence and cascade cost recalculations, plus a compiled Android tablet app for on-site field auditing.'
            : 'Desarrollo full-stack que moderniza el software de presupuestos técnicos en obra. Incluye un parser universal en Python con 0 dependencias runtime (soporta UTF-8, Windows-1252 y CP850), exportador a SQLite, JSON y CSV, un editor web interactivo con persistencia en IndexedDB y recálculo en cascada de mediciones, más una aplicación compilada para tablets Android para trabajar a pie de obra.',
        tags: ['Python (0 deps)', 'JavaScript SPA', 'Android APK (Tablet)', 'SQLite', 'IndexedDB', 'FIEBDC-3 (.BC3)'],
        arch: [
            { step: '01', title: 'Universal Ingestion', sub: 'UTF-8 / CP850 Auto' },
            { step: '02', title: 'WBS Tree Parse', sub: 'Hierarchical Cascade' },
            { step: '03', title: 'Relational Store', sub: 'SQLite / IndexedDB' },
            { step: '04', title: 'Android Runtime', sub: 'Native Tablet Client' }
        ],
        terminal: [
            { prompt: '$', cmd: 'python -m arqmed.cli parse --input ./data/edificacion_v2.bc3 --format sqlite --output output/' },
            { type: 'muted', text: '[INFO] Parsing FIEBDC-3 file: detected Windows-1252 encoding (14,280 lines)' },
            { type: 'muted', text: '[CASCADE] Recalculating tree: 12 chapters, 184 subchapters, 920 unit items' },
            { type: 'emerald', text: '[SUCCESS] Total project: 1,482,910.42 € (0 errors)' },
            { type: 'cyan', text: '[EXPORT] Generated: output/presupuesto.db (2.2 MB SQLite), JSON, CSV & Android client ready' }
        ]
    },
    {
        id: 'securechain',
        num: '02',
        title: 'SecureChain',
        categoryFilter: 'tfg',
        categoryTag: isEn ? 'Thesis // Backend & Formal Logic' : 'TFG // Backend & Lógica Formal',
        categoryChip: 'emerald',
        badgeFront: isEn ? 'Thesis' : 'TFG',
        sub: 'Go AST & Z3 Solver',
        tagline: isEn
            ? 'Software Supply Chain Security (SSC) for the Go ecosystem with mathematical constraint solving.'
            : 'Seguridad de la cadena de suministro de software (SSC) en el ecosistema Go con resolución formal.',
        specs: [
            { k: isEn ? 'Core' : 'Núcleo', v: 'Go AST + Python' },
            { k: 'Solver', v: 'Z3 Theorem Prover' },
            { k: 'Pipeline', v: 'FastAPI + Dagster' }
        ],
        github: 'https://github.com/alvarofdezr/securechain-ssc-ingestion',
        extraLink: {
            url: 'https://github.com/alvarofdezr/securechain-depex',
            text: 'depex-solver'
        },
        overview: isEn
            ? 'Massive backend ingestion pipeline and dependency graph solver for the Go ecosystem. Formulates version bounds as computable SAT/SMT problems with Z3 Theorem Prover to find mathematically optimal, CVE-free trees.'
            : 'Backend de ingesta masiva y análisis de dependencias para el ecosistema Go. Resuelve grafos de dependencias no triviales y vulnerabilidades transitivas mediante Z3 Theorem Prover, modelando versiones y restricciones como problemas SAT/SMT computables.',
        tags: ['Go AST', 'Python', 'Z3 SMT Solver', 'FastAPI', 'Dagster Pipelines', 'SAT/SMT'],
        arch: [
            { step: '01', title: 'Go Proxy Ingestion', sub: 'Dagster + Go AST' },
            { step: '02', title: 'Constraint Modeling', sub: 'Z3 Formula Generation' },
            { step: '03', title: 'SAT/SMT Solve', sub: 'Optimal Safe Tree' },
            { step: '04', title: 'Vulnerability Match', sub: 'OSV / CVE Database' }
        ],
        terminal: [
            { prompt: '$', cmd: 'securechain-depex solve --target github.com/gin-gonic/gin --ecosystem go' },
            { type: 'muted', text: '[INFO] Ingesting go.mod constraints for 42 dependencies...' },
            { type: 'muted', text: '[INFO] Generating Z3 boolean propositions (254 clauses)...' },
            { type: 'emerald', text: '[SOLVER] Status: SAT (optimal solution found in 84ms)' },
            { type: 'cyan', text: '[REPORT] 0 critical CVEs in resolved dependency graph.' }
        ]
    },
    {
        id: 'aegis',
        num: '03',
        title: 'Aegis Sentinel',
        categoryFilter: 'edr',
        categoryTag: isEn ? 'Systems & EDR Platform' : 'Sistemas & EDR Modular',
        categoryChip: 'cyan',
        badgeFront: 'EDR',
        sub: 'YARA & Host Hooking',
        tagline: isEn
            ? 'Modular EDR platform with host agent, YARA detection, and active automated response.'
            : 'Plataforma EDR modular con agente de host, detección YARA y mitigación activa.',
        specs: [
            { k: isEn ? 'Engine' : 'Motor', v: 'YARA + C2' },
            { k: 'Telemetry', v: 'FIM / Sockets' },
            { k: 'Sandbox', v: 'Docker Isolated' }
        ],
        github: 'https://github.com/alvarofdezr/Aegis-sentinel',
        overview: isEn
            ? 'Evolution of the baseline EDR (Basilisk). Real-time process monitoring, file integrity monitoring (FIM), anomalous socket connections, and integrated YARA signatures with automated network isolation.'
            : 'Evolución del sistema EDR base (Basilisk). Monitoriza eventos de procesos en tiempo real, integridad de archivos (FIM), conexiones anómalas e integra un motor de reglas YARA para la detección de binarios maliciosos con aislamiento de red automatizado.',
        tags: ['Python Low-Level', 'YARA Engine', 'C2 Architecture', 'FIM', 'Docker Sandbox'],
        arch: [
            { step: '01', title: 'Host Telemetry', sub: 'Process / FIM / Sockets' },
            { step: '02', title: 'YARA Scan Hook', sub: 'Memory & Binary Check' },
            { step: '03', title: 'C2 Pipeline', sub: 'FastAPI + RBAC Auth' },
            { step: '04', title: 'Mitigation', sub: 'Process Kill / Quarantine' }
        ],
        terminal: [
            { prompt: '$', cmd: 'aegis-agent --daemon --rules /etc/aegis/yara/' },
            { type: 'muted', text: '[AGENT] Hooking active process table... [PID: 1420-8910]' },
            { type: 'amber', text: '[ALERT] Suspicious binary execution detected in /tmp/mem_dump' },
            { type: 'amber', text: '[YARA] Rule match: APT_CobaltStrike_Beacon (confidence: 99.4%)' },
            { type: 'emerald', text: '[ACTION] SIGKILL sent to PID 4120. Endpoint network isolated.' }
        ]
    },
    {
        id: 'ares',
        num: '04',
        title: 'Ares',
        logoImg: '/logos/ares.png',
        categoryFilter: 'offensive',
        categoryTag: isEn ? 'Networking & High Concurrency' : 'Redes & Alta Concurrencia',
        categoryChip: 'amber',
        badgeFront: 'Network',
        sub: 'Go Raw Sockets',
        tagline: isEn
            ? 'High-throughput network reconnaissance & port scanner in Go with thousands of goroutines.'
            : 'Toolkit de reconocimiento y escaneo de puertos de alto rendimiento en Go con miles de goroutines.',
        specs: [
            { k: 'Runtime', v: 'Go 1.22' },
            { k: isEn ? 'Concurrency' : 'Concurrencia', v: 'Goroutines / Chan' },
            { k: 'Speed', v: '65k ports / 1.8s' }
        ],
        github: 'https://github.com/alvarofdezr/Ares',
        overview: isEn
            ? 'Ultra-fast reconnaissance engine written in Go. Designed to audit enterprise perimeter attack surfaces, execute banner grabbing, and probe ports with custom TCP handshake timings without packet dropping.'
            : 'Motor de reconocimiento de redes ultrarrápido programado en Go con miles de goroutines concurrentes. Diseñado para auditar perímetros externos, mapear superficies de ataque y realizar fingerprinting de servicios sin pérdida de paquetes bajo alta latencia.',
        tags: ['Go Concurrency', 'Goroutines / Channels', 'Raw Sockets', 'Port Scanning'],
        arch: [
            { step: '01', title: 'Target Ingest', sub: 'CIDR & Range Expand' },
            { step: '02', title: 'Worker Pool', sub: 'Goroutines Dispatch' },
            { step: '03', title: 'SYN Probe', sub: 'Non-blocking Sockets' },
            { step: '04', title: 'Fingerprint', sub: 'Banner / Service ID' }
        ],
        terminal: [
            { prompt: '$', cmd: 'ares scan --target 192.168.1.0/24 --concurrency 5000 --syn' },
            { type: 'muted', text: '[INIT] Dispatched 5,000 workers across pool...' },
            { type: 'emerald', text: '[OPEN] 192.168.1.42:22 (OpenSSH 8.9p1 Ubuntu)' },
            { type: 'emerald', text: '[OPEN] 192.168.1.42:443 (nginx/1.18.0 TLS 1.3)' },
            { type: 'cyan', text: '[DONE] 65,535 ports scanned in 1.84s (0 packets dropped)' }
        ]
    },
    {
        id: 'harpocrates',
        num: '05',
        title: 'Harpocrates',
        logoImg: '/logos/harpocrates.png',
        categoryFilter: 'crypto',
        categoryTag: isEn ? 'Cryptography // v2.0.0' : 'Criptografía // v2.0.0',
        categoryChip: 'emerald',
        badgeFront: 'Crypto',
        sub: 'Argon2id Vault',
        tagline: isEn
            ? 'Local Zero-Trust secrets manager with Argon2id memory-hard derivation and AES-256-GCM.'
            : 'Gestor de secretos con arquitectura hermética Zero-Trust y derivación Argon2id.',
        specs: [
            { k: 'KDF', v: 'Argon2id (64MB)' },
            { k: 'Cipher', v: 'AES-256-GCM' },
            { k: 'Wipe', v: 'RAM Zeroing' }
        ],
        github: 'https://github.com/alvarofdezr/Harpocrates',
        overview: isEn
            ? 'Local credential vault with zero cloud dependencies. Uses Argon2id memory-hard key derivation to resist GPU/ASIC attacks, AES-256-GCM authenticated encryption, and aggressive RAM memory wiping after every operation.'
            : 'Gestor de credenciales local sin dependencias en la nube. Emplea derivación de claves mediante Argon2id resistente a GPU/ASIC, cifrado autenticado AES-256-GCM y limpieza activa de búferes de memoria RAM tras cada operación criptográfica.',
        tags: ['Python', 'AES-256-GCM', 'Argon2id', 'Zero-Knowledge', 'RAM Wipe'],
        arch: [
            { step: '01', title: 'Master Key Prompt', sub: 'Entropy Check' },
            { step: '02', title: 'Argon2id KDF', sub: '64MB RAM / 4 Passes' },
            { step: '03', title: 'AES-256-GCM', sub: 'Auth Tag Verify' },
            { step: '04', title: 'Secure Wipe', sub: 'RAM Zeroing' }
        ],
        terminal: [
            { prompt: '$', cmd: 'harpocrates unlock --vault /sec/keys.vault' },
            { type: 'muted', text: '[KDF] Deriving 256-bit key via Argon2id (memory: 65536 KB)...' },
            { type: 'emerald', text: '[AUTH] GCM tag verified. Vault unlocked in 310ms.' },
            { type: 'cyan', text: '[MEM] Key purged from memory buffers. Ready.' }
        ]
    },
    {
        id: 'basilisk',
        num: '06',
        title: 'Basilisk',
        logoImg: '/logos/basilisk.png',
        categoryFilter: 'edr',
        categoryTag: isEn ? 'Systems // EDR Base' : 'Sistemas // EDR Base',
        categoryChip: 'cyan',
        badgeFront: 'Core EDR',
        sub: 'mTLS Host Telemetry',
        tagline: isEn
            ? 'Foundational EDR architecture with decoupled agent, minimal overhead, and mTLS C2.'
            : 'Arquitectura EDR fundacional con agente ligero y telemetría de endpoints.',
        specs: [
            { k: 'Transport', v: 'mTLS 1.3' },
            { k: 'FIM', v: 'SHA-256 Hashes' },
            { k: 'C2', v: 'FastAPI Async' }
        ],
        github: 'https://github.com/alvarofdezr/Basilisk',
        overview: isEn
            ? 'The bedrock system upon which Aegis Sentinel was designed. Modular endpoint detection agent with minimal CPU overhead, centralized network telemetry collection, FIM, and real-time C2 dashboarding.'
            : 'La arquitectura base sobre la que se construyó Aegis Sentinel. Sistema de detección de punto final con agente desacoplado de baja sobrecarga de CPU, colector central de telemetría de red, FIM y motor de persistencia SQLite/Redis.',
        tags: ['Python', 'FIM Telemetry', 'FastAPI C2', 'Process Tree', 'mTLS'],
        arch: [
            { step: '01', title: 'Host Agent', sub: 'Periodic Snapshot' },
            { step: '02', title: 'mTLS Transport', sub: 'Secure Heartbeat' },
            { step: '03', title: 'Event Ingestion', sub: 'FastAPI Async Server' },
            { step: '04', title: 'Dashboard Alerts', sub: 'WebSocket Push' }
        ],
        terminal: [
            { prompt: '$', cmd: 'python -m basilisk.server --port 8443' },
            { type: 'muted', text: '[C2] Listening for agent telemetry over TLS 1.3 on :8443' },
            { type: 'emerald', text: '[AGENT_01] Heartbeat received from host-linux-01 (Uptime: 48h)' },
            { type: 'cyan', text: '[FIM] Clean: 0 modified system binaries in /bin, /usr/bin' }
        ]
    },
    {
        id: 'cript',
        num: '07',
        title: 'Cript',
        categoryFilter: 'crypto',
        categoryTag: isEn ? 'Cryptography // Protocols' : 'Criptografía // Protocolos',
        categoryChip: 'emerald',
        badgeFront: 'Double Ratchet',
        sub: 'E2EE Simulation',
        tagline: isEn
            ? 'Didactic framework simulating secure communication channels & Double Ratchet algorithm.'
            : 'Framework didáctico de simulación de canales seguros y Double Ratchet E2EE.',
        specs: [
            { k: 'Algorithm', v: 'Double Ratchet' },
            { k: 'PFS', v: 'Forward Secrecy' },
            { k: 'KDF', v: 'HKDF Chains' }
        ],
        github: 'https://github.com/alvarofdezr/cript',
        overview: isEn
            ? 'Mathematical simulation and implementation of End-to-End Encrypted (E2EE) protocols based on the Double Ratchet algorithm (as utilized in Signal). Enforces Perfect Forward Secrecy (PFS) and Post-Compromise Security (PCS) via continuous HKDF key ratchet chains.'
            : 'Framework didáctico de simulación e implementación de canales seguros extremo a extremo (E2EE) basado en el algoritmo Double Ratchet (utilizado en Signal). Implementa Perfect Forward Secrecy (PFS) y Post-Compromise Security (PCS).',
        tags: ['Double Ratchet', 'HKDF', 'PFS / PCS', 'Diffie-Hellman', 'Cryptography'],
        arch: [
            { step: '01', title: 'X3DH Handshake', sub: 'Initial Shared Secret' },
            { step: '02', title: 'DH Ratchet', sub: 'Asymmetric Step' },
            { step: '03', title: 'Symmetric KDF', sub: 'Message Key Chain' },
            { step: '04', title: 'PFS Zeroing', sub: 'Instant Key Erase' }
        ],
        terminal: [
            { prompt: '$', cmd: 'python -m cript.simulate --alice --bob --ratchet-steps 10' },
            { type: 'muted', text: '[X3DH] Prekey bundle exchange verified between Alice & Bob' },
            { type: 'cyan', text: '[DH-RATCHET] Stepping curve25519 root key... New epoch' },
            { type: 'emerald', text: '[E2EE] 10/10 messages delivered with PFS. Zero plaintext leakage.' }
        ]
    }
];
---

<div class="project-vignettes-wrapper" data-vignette-root>
    <!-- ── 1. CABECERA DEL ESTANTE 3D ── -->
    <div class="deck-header-row">
        <div class="deck-indicator">
            <span class="beacon-dot"></span>
            <span class="deck-indicator-label">{isEn ? 'Project Collection' : 'Colección de proyectos'}</span>
        </div>
        <div class="deck-nav-buttons">
            <button class="deck-arrow-btn prev-btn" data-shelf-prev title={isEn ? 'Previous project' : 'Proyecto anterior'}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <span class="deck-counter" data-shelf-counter>01 / 07</span>
            <button class="deck-arrow-btn next-btn" data-shelf-next title={isEn ? 'Next project' : 'Proyecto siguiente'}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
            </button>
        </div>
    </div>

    <!-- ── 2. ESTANTE 3D (SOLO 3 VIÑETAS VISIBLES CON GIRO 180° Y LOGOS OFICIALES) ── -->
    <div class="shelf-3d-viewport" data-shelf-viewport>
        <div class="shelf-ambient-glow"></div>

        <div class="shelf-3d-stage" data-shelf-stage>
            {projects.map((proj, idx) => {
                let initialPos = 'hidden';
                if (idx === 0) initialPos = 'center';
                else if (idx === 1) initialPos = 'right';
                else if (idx === projects.length - 1) initialPos = 'left';

                return (
                    <div 
                        class={`vignette-card ${idx === 0 ? 'is-selected' : ''}`} 
                        data-project-id={proj.id} 
                        data-category={proj.categoryFilter}
                        data-index={idx}
                        data-pos={initialPos}
                        tabindex="0"
                        role="button"
                        aria-label={`${proj.title} - ${proj.sub}`}
                    >
                        <div class="vignette-inner">
                            <!-- CARA FRONTAL (LOGO OFICIAL + IDENTIFICACIÓN) -->
                            <div class="vignette-face vignette-front">
                                <div class="vignette-face-top">
                                    <div class="vignette-id-group">
                                        <span class="vignette-num">{proj.num}</span>
                                        <span class={`vignette-chip ${proj.categoryChip}`}>{proj.badgeFront}</span>
                                    </div>
                                    <button class="flip-trigger-btn" type="button" title={isEn ? 'Flip card 180°' : 'Girar viñeta 180°'} aria-label={isEn ? 'Flip card' : 'Girar viñeta'}>
                                        <span>↻</span>
                                    </button>
                                </div>

                                <div class="vignette-logo-zone">
                                    <div class="logo-pedestal-ring"></div>
                                    {proj.logoImg ? (
                                        <img 
                                            src={proj.logoImg} 
                                            alt={`${proj.title} official logo`} 
                                            class={`vignette-logo-img logo-${proj.id}`}
                                            loading="eager"
                                        />
                                    ) : (
                                        <>
                                            {proj.id === 'securechain' && (
                                                <svg viewBox="0 0 48 48" fill="none" class="vignette-svg securechain-svg">
                                                    <path d="M24 5L8 12V22C8 32 15 41 24 43C33 41 40 32 40 22V12L24 5Z" stroke="#10b981" stroke-width="2.2" fill="rgba(16,185,129,0.08)"/>
                                                    <path d="M19 22L24 17L29 22M24 17V31" stroke="#00f0ff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                                                    <circle cx="24" cy="17" r="3" fill="#00f0ff"/>
                                                    <circle cx="19" cy="27" r="2.5" fill="#10b981"/>
                                                    <circle cx="29" cy="27" r="2.5" fill="#10b981"/>
                                                </svg>
                                            )}

                                            {proj.id === 'aegis' && (
                                                <svg viewBox="0 0 48 48" fill="none" class="vignette-svg aegis-svg">
                                                    <circle cx="24" cy="24" r="17" stroke="#00f0ff" stroke-width="1.8" stroke-dasharray="3 3"/>
                                                    <circle cx="24" cy="24" r="10" stroke="#00f0ff" stroke-width="1.5" opacity="0.6"/>
                                                    <circle cx="24" cy="24" r="4" fill="#00f0ff"/>
                                                    <path d="M24 7V11M24 37V41M7 24H11M37 24H41" stroke="#00f0ff" stroke-width="2" stroke-linecap="round"/>
                                                    <path d="M24 24L32 16" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
                                                </svg>
                                            )}

                                            {proj.id === 'cript' && (
                                                <svg viewBox="0 0 48 48" fill="none" class="vignette-svg cript-svg">
                                                    <circle cx="18" cy="24" r="9" stroke="#00f0ff" stroke-width="2" stroke-dasharray="4 2"/>
                                                    <circle cx="30" cy="24" r="9" stroke="#10b981" stroke-width="2" stroke-dasharray="4 2"/>
                                                    <circle cx="18" cy="24" r="3" fill="#00f0ff"/>
                                                    <circle cx="30" cy="24" r="3" fill="#10b981"/>
                                                </svg>
                                            )}
                                        </>
                                    )}
                                </div>

                                <div class="vignette-face-bottom">
                                    <h4 class="vignette-title">{proj.title}</h4>
                                    <span class="vignette-sub">{proj.sub}</span>
                                </div>
                            </div>

                            <!-- CARA TRASERA (GIRADA 180° — SPECS & ACCIÓN) -->
                            <div class="vignette-face vignette-back">
                                <div class="vignette-face-top">
                                    <span class="vignette-chip cyan">{proj.title} // Specs</span>
                                    <button class="flip-trigger-btn" type="button" title={isEn ? 'Flip card back' : 'Volver a girar'} aria-label={isEn ? 'Flip card back' : 'Volver a girar'}>
                                        <span>↻</span>
                                    </button>
                                </div>

                                <div class="vignette-specs-list">
                                    {proj.specs.map((s) => (
                                        <div class="vignette-spec-row">
                                            <span class="spec-k">{s.k}</span>
                                            <span class="spec-v">{s.v}</span>
                                        </div>
                                    ))}
                                </div>

                                <div class="vignette-back-action">
                                    <span class="vignette-action-hint">{isEn ? 'Active in showcase below' : 'Activo en ficha inferior'} ↓</span>
                                </div>
                            </div>
                        </div>
                    </div>
                );
            })}
        </div>

        <!-- Base física del estante y puntos de posición -->
        <div class="shelf-ledge-bar">
            <div class="shelf-ledge-reflection"></div>
            <div class="shelf-dots" data-shelf-dots>
                {projects.map((proj, idx) => (
                    <button 
                        type="button"
                        class={`shelf-dot ${idx === 0 ? 'active' : ''}`} 
                        data-dot-index={idx}
                        title={proj.title}
                        aria-label={proj.title}
                    >
                        <span class="dot-num">{proj.num}</span>
                        <span class="dot-name">{proj.title}</span>
                    </button>
                ))}
            </div>
        </div>
    </div>

    <!-- ── 3. ACTIVE PROJECT STAGE SHOWCASE ── -->
    <div class="active-stage-container" data-project-stage>
        {projects.map((proj, idx) => (
            <article 
                class={`project-multi-card spotlight-card ${idx === 0 ? 'is-active-card' : 'is-hidden-card'}`} 
                data-project-card={proj.id}
            >
                <div class="card-head">
                    <div class="head-left">
                        <div class="title-row">
                            {proj.logoImg && (
                                <img src={proj.logoImg} alt={proj.title} class="stage-proj-logo" />
                            )}
                            <span class="stage-proj-num">{proj.num}</span>
                            <h3>{proj.title}</h3>
                            <span class={`badge-chip ${proj.categoryChip}`}>{proj.categoryTag}</span>
                        </div>
                        <p class="project-tagline">{proj.tagline}</p>
                    </div>
                    <div class="head-actions">
                        <a href={proj.github} target="_blank" rel="noopener noreferrer" class="btn-tactile btn-ghost" title={isEn ? 'Repository' : 'Repositorio'}>
                            <span class="btn-text">GitHub</span>
                            <span class="arrow-up">↗</span>
                        </a>
                        {proj.extraLink && (
