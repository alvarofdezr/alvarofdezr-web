<script>
    function setupVignetteShelf() {
        const roots = document.querySelectorAll<HTMLElement>('[data-vignette-root]');

        roots.forEach((root) => {
            if (root.dataset.initialized === 'true') return;
            root.dataset.initialized = 'true';

            const viewport = root.querySelector<HTMLElement>('[data-shelf-viewport]');
            const cards = Array.from(root.querySelectorAll<HTMLElement>('.vignette-card'));
            const dots = Array.from(root.querySelectorAll<HTMLElement>('.shelf-dot'));
            const articles = Array.from(root.querySelectorAll<HTMLElement>('.project-multi-card[data-project-card]'));
            const counterEl = root.querySelector<HTMLElement>('[data-shelf-counter]');
            const prevBtn = root.querySelector<HTMLElement>('[data-shelf-prev]');
            const nextBtn = root.querySelector<HTMLElement>('[data-shelf-next]');

            const total = cards.length;
            if (!total || !articles.length) return;

            let currentIndex = 0;
            let lastStepTime = 0;
            let lastPointerX: number | null = null;
            let lastPointerY: number | null = null;
            let accumDx = 0;

            function updateShelfPositions(newIndex: number, playSound = true) {
                currentIndex = ((newIndex % total) + total) % total;

                cards.forEach((card, idx) => {
                    let diff = idx - currentIndex;
                    if (diff > total / 2) diff -= total;
                    if (diff < -total / 2) diff += total;

                    card.classList.toggle('is-selected', diff === 0);
                    if (diff !== 0) {
                        card.classList.remove('is-flipped');
                    }

                    if (diff === 0) {
                        card.setAttribute('data-pos', 'center');
                    } else if (diff === -1) {
                        card.setAttribute('data-pos', 'left');
                    } else if (diff === 1) {
                        card.setAttribute('data-pos', 'right');
                    } else if (diff < -1) {
                        card.setAttribute('data-pos', 'far-left');
                    } else {
                        card.setAttribute('data-pos', 'far-right');
                    }
                });

                dots.forEach((dot, idx) => {
                    dot.classList.toggle('active', idx === currentIndex);
                });

                if (counterEl) {
                    const numStr = String(currentIndex + 1).padStart(2, '0');
                    const totStr = String(total).padStart(2, '0');
                    counterEl.innerText = `${numStr} / ${totStr}`;
                }

                const targetId = cards[currentIndex].getAttribute('data-project-id');
                articles.forEach((art) => {
                    if (art.getAttribute('data-project-card') === targetId) {
                        art.classList.remove('is-hidden-card');
                        art.classList.add('is-active-card');
                    } else {
                        art.classList.remove('is-active-card');
                        art.classList.add('is-hidden-card');
                    }
                });

                if (playSound && (window as any).soundEngine) {
                    (window as any).soundEngine.playClick(640, 0.025);
                }
            }

            if (viewport) {
                viewport.addEventListener('pointermove', (e: PointerEvent) => {
                    if (lastPointerX !== null && lastPointerY !== null) {
                        const dx = e.clientX - lastPointerX;
                        const dy = e.clientY - lastPointerY;

                        if (Math.abs(dx) > Math.abs(dy) * 1.25) {
                            accumDx += dx;
                            const now = performance.now();
                            if (Math.abs(accumDx) >= 115 && now - lastStepTime > 210) {
                                const step = accumDx > 0 ? 1 : -1;
                                updateShelfPositions(currentIndex + step);
                                accumDx = 0;
                                lastStepTime = now;
                            }
                        } else if (Math.abs(dy) > Math.abs(dx) * 1.5) {
                            accumDx = 0;
                        }
                    }

                    lastPointerX = e.clientX;
                    lastPointerY = e.clientY;
                });

                viewport.addEventListener('pointerleave', () => {
                    lastPointerX = null;
                    lastPointerY = null;
                    accumDx = 0;
                });

                viewport.addEventListener('wheel', (e: WheelEvent) => {
                    const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
                    if (Math.abs(delta) > 12) {
                        e.preventDefault();
                        const now = performance.now();
                        if (now - lastStepTime > 200) {
                            updateShelfPositions(currentIndex + (delta > 0 ? 1 : -1));
                            lastStepTime = now;
                        }
                    }
                }, { passive: false });
            }

            cards.forEach((card, idx) => {
                card.addEventListener('click', (e) => {
                    const flipBtn = (e.target as HTMLElement).closest('.flip-trigger-btn');
                    if (flipBtn) {
                        e.stopPropagation();
                        if (idx !== currentIndex) {
                            updateShelfPositions(idx);
                        }
                        card.classList.toggle('is-flipped');
                        if ((window as any).soundEngine) {
                            (window as any).soundEngine.playClick(850, 0.02);
                        }
                        return;
                    }

                    if (idx !== currentIndex) {
                        updateShelfPositions(idx);
                    } else {
                        card.classList.toggle('is-flipped');
                        if ((window as any).soundEngine) {
                            (window as any).soundEngine.playClick(820, 0.02);
                        }
                    }
                });

                card.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        if (idx !== currentIndex) {
                            updateShelfPositions(idx);
                        } else {
                            card.classList.toggle('is-flipped');
                        }
                    } else if (e.key === 'ArrowRight') {
                        e.preventDefault();
                        updateShelfPositions(currentIndex + 1);
                    } else if (e.key === 'ArrowLeft') {
                        e.preventDefault();
                        updateShelfPositions(currentIndex - 1);
                    }
                });
            });

            dots.forEach((dot, idx) => {
                dot.addEventListener('click', () => updateShelfPositions(idx));
            });

            prevBtn?.addEventListener('click', () => updateShelfPositions(currentIndex - 1));
            nextBtn?.addEventListener('click', () => updateShelfPositions(currentIndex + 1));

            articles.forEach((art) => {
                const tabBtns = art.querySelectorAll('.tab-btn');
                const panels = art.querySelectorAll('.tab-content');

                tabBtns.forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const targetTab = btn.getAttribute('data-tab');
                        tabBtns.forEach((b) => b.classList.remove('active'));
                        panels.forEach((p) => p.classList.remove('active'));

                        btn.classList.add('active');
                        const targetPanel = art.querySelector(`[data-panel="${targetTab}"]`);
                        targetPanel?.classList.add('active');
                    });
                });
            });

            updateShelfPositions(0, false);
        });
    }

    setupVignetteShelf();
    document.addEventListener('astro:after-swap', setupVignetteShelf);
</script>
