---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="nav-island" id="fluid-nav">
    <div class="nav-brand">
        <a href="/">{SITE_TITLE}</a>
    </div>

    <!-- Desktop Nav -->
    <nav class="nav-links desktop-only">
        <HeaderLink href="/">Inicio</HeaderLink>
        <HeaderLink href="/projects">Proyectos</HeaderLink>
        <HeaderLink href="/stack">Stack</HeaderLink>
        <HeaderLink href="/profile">Perfil</HeaderLink>
    </nav>

    <div class="nav-actions">
        <button id="theme-toggle" class="icon-btn" aria-label="Cambiar tema">
            <!-- Phosphor Light: Sun -->
            <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="12" d="M128 40V16m0 224v-24m62.23-150.23l16.97-16.97M48.8 207.2l16.97-16.97M240 128h-24M40 128H16m175.2 62.23l-16.97-16.97M65.77 65.77L48.8 48.8M128 176a48 48 0 1 0-48-48a48.05 48.05 0 0 0 48 48Z"/></svg>
            <!-- Phosphor Light: Moon -->
            <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="12" d="M216.7 152.6A91.98 91.98 0 0 1 103.4 39.3a92 92 0 1 0 113.3 113.3Z"/></svg>
        </button>

        <!-- Hamburger Menu for Mobile -->
        <button id="mobile-menu-btn" class="icon-btn mobile-only" aria-label="Abrir menú">
            <div class="hamburger-morph">
                <span></span>
                <span></span>
            </div>
        </button>
    </div>
</header>

<!-- Mobile Expanded Menu -->
<div id="mobile-overlay" class="mobile-overlay">
    <nav class="mobile-nav-links">
        <HeaderLink href="/">Inicio</HeaderLink>
        <HeaderLink href="/projects">Proyectos</HeaderLink>
        <HeaderLink href="/stack">Stack</HeaderLink>
        <HeaderLink href="/profile">Perfil</HeaderLink>
    </nav>
</div>

<style>
    /* Desktop layout is defined in global.css via .nav-island */
    .nav-brand a {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--text-primary);
        text-decoration: none;
        letter-spacing: -0.02em;
    }

    .nav-links {
        display: flex;
        gap: 2rem;
    }

    .nav-links a {
        font-family: var(--font-body);
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text-secondary);
        text-decoration: none;
        transition: color 0.4s var(--ease-spring);
    }

    .nav-links a:hover,
    .nav-links a.active {
        color: var(--text-primary);
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .icon-btn {
        background: transparent;
        border: none;
        color: var(--text-secondary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        transition: color 0.4s var(--ease-spring), background 0.4s var(--ease-spring), transform 0.4s var(--ease-spring);
    }

    .icon-btn:hover {
        color: var(--text-primary);
        background: rgba(255, 255, 255, 0.05);
        transform: scale(1.05);
    }

    html:not(.dark) .icon-btn:hover {
        background: rgba(0, 0, 0, 0.05);
    }

    .sun-icon { display: none; }
    .moon-icon { display: block; }
    html.dark .sun-icon { display: block; }
    html.dark .moon-icon { display: none; }

    /* Mobile Morph */
    .mobile-only { display: none; }
    .desktop-only { display: flex; }

    .hamburger-morph {
        position: relative;
        width: 18px;
        height: 12px;
    }
    .hamburger-morph span {
        position: absolute;
        left: 0;
        width: 100%;
        height: 1.5px;
        background: currentColor;
        transition: all 0.5s var(--ease-spring);
        transform-origin: center;
    }
    .hamburger-morph span:first-child { top: 0; }
    .hamburger-morph span:last-child { bottom: 0; }
    
    .is-open .hamburger-morph span:first-child { transform: translateY(5px) rotate(45deg); }
    .is-open .hamburger-morph span:last-child { transform: translateY(-5.5px) rotate(-45deg); }

    /* Mobile Overlay */
    .mobile-overlay {
        position: fixed;
        inset: 0;
        z-index: 40;
        background: var(--bg-base);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.6s var(--ease-in-out);
        backdrop-filter: blur(40px);
        -webkit-backdrop-filter: blur(40px);
    }
    .mobile-overlay.is-active {
        opacity: 1;
        pointer-events: auto;
    }

    .mobile-nav-links {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
        text-align: center;
    }

    .mobile-nav-links a {
        font-family: var(--font-display);
        font-size: 2.5rem;
        font-weight: 500;
        color: var(--text-primary);
        text-decoration: none;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.6s var(--ease-spring);
    }

    .mobile-overlay.is-active .mobile-nav-links a {
        opacity: 1;
        transform: translateY(0);
    }
    .mobile-overlay.is-active .mobile-nav-links a:nth-child(1) { transition-delay: 0.1s; }
    .mobile-overlay.is-active .mobile-nav-links a:nth-child(2) { transition-delay: 0.15s; }
    .mobile-overlay.is-active .mobile-nav-links a:nth-child(3) { transition-delay: 0.2s; }
    .mobile-overlay.is-active .mobile-nav-links a:nth-child(4) { transition-delay: 0.25s; }

    @media (max-width: 768px) {
        .mobile-only { display: flex; }
        .desktop-only { display: none; }
    }
</style>

<script>
    const setupHeader = () => {
        // Theme toggle logic
        const toggle = document.getElementById('theme-toggle');
        if (toggle) {
            toggle.replaceWith(toggle.cloneNode(true));
            const newToggle = document.getElementById('theme-toggle');
            newToggle?.addEventListener('click', () => {
                const element = document.documentElement;
                element.classList.toggle('dark');
                localStorage.setItem('theme', element.classList.contains('dark') ? 'dark' : 'light');
            });
        }

        // Mobile menu logic
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const overlay = document.getElementById('mobile-overlay');
        if (mobileBtn && overlay) {
            mobileBtn.replaceWith(mobileBtn.cloneNode(true));
            const newMobileBtn = document.getElementById('mobile-menu-btn');
            
            newMobileBtn?.addEventListener('click', () => {
                newMobileBtn.classList.toggle('is-open');
                overlay.classList.toggle('is-active');
                document.body.style.overflow = overlay.classList.contains('is-active') ? 'hidden' : '';
            });
        }
    };

    setupHeader();
    document.addEventListener('astro:after-swap', setupHeader);
</script>