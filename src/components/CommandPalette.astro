---
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale || 'es';
const t = useTranslations(lang as any);
const basePath = lang === 'en' ? '/en' : '';
---

<div id="cmd-dialog-backdrop" class="cmd-backdrop" aria-hidden="true" style="display: none;">
    <div class="cmd-dialog" role="dialog" aria-modal="true" aria-label="Command Palette">
        <div class="cmd-input-bar">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input 
                id="cmd-search-input" 
                type="text" 
                placeholder={lang === 'es' ? "Escribe un comando o busca algo..." : "Type a command or search..."} 
                autocomplete="off" 
                spellcheck="false"
            />
            <kbd class="esc-kbd">ESC</kbd>
        </div>

        <div class="cmd-list" id="cmd-options-list">
            <div class="cmd-group-title">{lang === 'es' ? "Navegación" : "Navigation"}</div>
            
            <a href={basePath === '' ? '/' : basePath} class="cmd-item" data-title="Inicio Home">
                <span class="cmd-icon">⚡</span>
                <span class="cmd-label">{t('nav.home')}</span>
                <span class="cmd-shortcut">/</span>
            </a>
            <a href={`${basePath}/projects`} class="cmd-item" data-title="Proyectos Projects Arqmed Android SecureChain EDR Ares">
                <span class="cmd-icon">📁</span>
                <span class="cmd-label">{t('nav.projects')}</span>
                <span class="cmd-shortcut">P</span>
            </a>
            <a href={`${basePath}/stack`} class="cmd-item" data-title="Stack Arsenal Herramientas Tools Python Go Android SQLite Web">
                <span class="cmd-icon">🛠️</span>
                <span class="cmd-label">{t('nav.stack')}</span>
                <span class="cmd-shortcut">S</span>
            </a>
            <a href={`${basePath}/profile`} class="cmd-item" data-title="Perfil Profile Bio Trayectoria">
                <span class="cmd-icon">👤</span>
                <span class="cmd-label">{t('nav.profile')}</span>
                <span class="cmd-shortcut">B</span>
            </a>

            <div class="cmd-group-title">{lang === 'es' ? "Acciones Rápidas" : "Quick Actions"}</div>

            <button type="button" class="cmd-item" data-action="copy-email" data-title="Copiar Email Correo Contacto">
                <span class="cmd-icon">✉️</span>
                <span class="cmd-label">{lang === 'es' ? "Copiar email de contacto" : "Copy contact email"}</span>
                <span class="cmd-shortcut">Email</span>
            </button>
            <button type="button" class="cmd-item" data-action="toggle-theme" data-title="Tema Theme Dark Light Mode">
                <span class="cmd-icon">🌓</span>
                <span class="cmd-label">{lang === 'es' ? "Alternar Modo Oscuro / Claro" : "Toggle Dark / Light Mode"}</span>
                <span class="cmd-shortcut">Theme</span>
            </button>

            <div class="cmd-group-title">{lang === 'es' ? "Enlaces Externos" : "External Links"}</div>

            <a href="https://github.com/alvarofdezr" target="_blank" rel="noopener noreferrer" class="cmd-item" data-title="GitHub Repositorios Codigo">
                <span class="cmd-icon">🐙</span>
                <span class="cmd-label">GitHub: @alvarofdezr</span>
                <span class="cmd-shortcut">↗</span>
            </a>
            <a href="https://www.linkedin.com/in/%C3%A1lvaro-fern%C3%A1ndez-71b25a404" target="_blank" rel="noopener noreferrer" class="cmd-item" data-title="LinkedIn Perfil Laboral">
                <span class="cmd-icon">💼</span>
                <span class="cmd-label">LinkedIn</span>
                <span class="cmd-shortcut">↗</span>
            </a>
        </div>
    </div>
</div>

<style>
    .cmd-backdrop {
        position: fixed;
        inset: 0;
        z-index: 999;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: clamp(10vh, 15vh, 18vh);
        padding-inline: 1rem;
        animation: fadeIn 0.15s ease-out;
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .cmd-dialog {
        width: 100%;
        max-width: 600px;
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-medium);
        border-radius: var(--radius-md);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), 0 0 0 1px var(--border-subtle);
        overflow: hidden;
        animation: scaleUp 0.18s var(--ease-spring);
    }

    @keyframes scaleUp {
        from { transform: scale(0.96) translateY(-8px); opacity: 0; }
        to { transform: scale(1) translateY(0); opacity: 1; }
    }

    .cmd-input-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border-subtle);
    }

    .search-icon {
        color: var(--text-muted);
        flex-shrink: 0;
    }

    .cmd-input-bar input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        font-family: var(--font-body);
        font-size: 1rem;
        color: var(--text-primary);
    }

    .cmd-input-bar input::placeholder {
        color: var(--text-muted);
    }

    .esc-kbd {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        color: var(--text-muted);
    }

    .cmd-list {
        max-height: 380px;
        overflow-y: auto;
        padding: 0.5rem;
    }

    .cmd-group-title {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        padding: 0.5rem 0.75rem 0.25rem;
    }

    .cmd-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        padding: 0.65rem 0.75rem;
        border-radius: var(--radius-sm);
        background: transparent;
        border: none;
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: 0.9rem;
        text-decoration: none;
        cursor: pointer;
        text-align: left;
        transition: background-color 100ms var(--ease-out), color 100ms var(--ease-out), transform 100ms var(--ease-out);
    }

    .cmd-item:hover,
    .cmd-item.selected {
        background: var(--bg-surface-hover);
        color: var(--accent-cyan);
    }

    .cmd-item:active {
        transform: scale(0.985);
    }

    .cmd-icon {
        font-size: 1rem;
        flex-shrink: 0;
    }

    .cmd-label {
        flex: 1;
    }

    .cmd-shortcut {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
    }
</style>

<script>
    function setupCommandPalette() {
        const backdrop = document.getElementById('cmd-dialog-backdrop');
        const input = document.getElementById('cmd-search-input') as HTMLInputElement;
        const list = document.getElementById('cmd-options-list');
        const items = list?.querySelectorAll<HTMLElement>('.cmd-item');

        let isOpen = false;
        let selectedIndex = 0;

        function openPalette() {
            if (!backdrop || !input) return;
            isOpen = true;
            backdrop.style.display = 'flex';
            input.value = '';
            filterItems('');
            input.focus();
        }

        function closePalette() {
            if (!backdrop) return;
            isOpen = false;
            backdrop.style.display = 'none';
        }

        function getVisibleItems(): HTMLElement[] {
            if (!items) return [];
            return Array.from(items).filter((item) => item.style.display !== 'none');
        }

        function updateSelection(newIndex: number) {
            const visible = getVisibleItems();
            if (visible.length === 0) return;
            visible.forEach((el) => el.classList.remove('selected'));
            selectedIndex = (newIndex + visible.length) % visible.length;
            visible[selectedIndex]?.classList.add('selected');
            visible[selectedIndex]?.scrollIntoView({ block: 'nearest' });
        }

        function filterItems(query: string) {
            const q = query.toLowerCase().trim();
            if (!items) return;
            items.forEach((item) => {
                const title = (item.getAttribute('data-title') || '').toLowerCase();
                const text = item.textContent?.toLowerCase() || '';
                if (!q || title.includes(q) || text.includes(q)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
            updateSelection(0);
        }

        input?.addEventListener('input', (e) => {
            filterItems((e.target as HTMLInputElement).value);
        });

        window.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                if (isOpen) closePalette();
                else openPalette();
            } else if (e.key === 'Escape' && isOpen) {
                e.preventDefault();
                closePalette();
            } else if (isOpen) {
                const visible = getVisibleItems();
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    updateSelection(selectedIndex + 1);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    updateSelection(selectedIndex - 1);
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    const target = visible[selectedIndex];
                    if (target) {
                        target.click();
                        closePalette();
                    }
                }
            }
        });

        backdrop?.addEventListener('click', (e) => {
            if (e.target === backdrop) closePalette();
        });

        document.querySelectorAll('[data-open-cmd]').forEach((btn) => {
            btn.addEventListener('click', openPalette);
        });

        items?.forEach((item) => {
            item.addEventListener('click', () => {
                const action = item.getAttribute('data-action');
                if (action === 'copy-email') {
                    navigator.clipboard.writeText('alvarofdezr@gmail.com');
                    if ((window as any).showToast) (window as any).showToast('Email copiado: alvarofdezr@gmail.com');
                    closePalette();
                } else if (action === 'toggle-theme') {
                    const toggleBtn = document.getElementById('theme-toggle');
                    if (toggleBtn) toggleBtn.click();
                    closePalette();
                }
            });
        });
    }

    setupCommandPalette();
    document.addEventListener('astro:after-swap', setupCommandPalette);
</script>
