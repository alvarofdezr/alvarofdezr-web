---
const today = new Date();
import MotionEngine from './MotionEngine.astro';
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale || 'es';
const t = useTranslations(lang as any);
---

<footer class="tactical-footer container">
    <div class="footer-terminal-banner spotlight-card reveal-up">
        <div class="terminal-header">
            <div class="terminal-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
            </div>
            <div class="terminal-title">contact // handshake.init</div>
            <div class="terminal-status">
                <span class="beacon-dot"></span>
                <span>SEVILLA, ES</span>
            </div>
        </div>

        <div class="terminal-body">
            <div class="terminal-main">
                <h2>{lang === 'es' ? '¿Construimos algo grande?' : 'Let’s Build Something Great'}</h2>
                <p>
                    {lang === 'es' 
                        ? 'Desarrollo de aplicaciones full-stack, ingeniería de sistemas, automatizaciones, apps Android y arquitecturas seguras. Si tienes un proyecto o buscas un perfil técnico versátil, hablemos.' 
                        : 'Full-stack software engineering, systems design, automations, Android apps, and robust architectures. If you have a project or need a versatile technical engineer, let’s talk.'}
                </p>
                
                <div class="terminal-actions">
                    <button class="btn-tactile btn-primary" data-copy="alvarofdezr@gmail.com" data-copy-label={lang === 'es' ? 'Email copiado: alvarofdezr@gmail.com' : 'Email copied: alvarofdezr@gmail.com'}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                        <span>{lang === 'es' ? 'Copiar email directo' : 'Copy direct email'}</span>
                    </button>

                    <a href="mailto:alvarofdezr@gmail.com" class="btn-tactile btn-secondary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                        <span>{lang === 'es' ? 'Abrir cliente de correo' : 'Open mail client'}</span>
                    </a>
                </div>
            </div>

            <div class="terminal-meta">
                <div class="meta-item">
                    <span class="meta-label">SOCIAL // PROFILES</span>
                    <div class="social-pills">
                        <a href="https://github.com/alvarofdezr" target="_blank" rel="noopener noreferrer" class="social-pill">
                            <span>GitHub</span>
                            <span class="arrow-up">↗</span>
                        </a>
                        <a href="https://www.linkedin.com/in/%C3%A1lvaro-fern%C3%A1ndez-71b25a404" target="_blank" rel="noopener noreferrer" class="social-pill">
                            <span>LinkedIn</span>
                            <span class="arrow-up">↗</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="footer-legal">
        <p class="copyright">&copy; {today.getFullYear()} Álvaro Fernández Ramos · <span class="tag-loc">Sevilla, Spain</span></p>
    </div>

    <MotionEngine />
</footer>

<style>
    .tactical-footer {
        padding-top: var(--macro-gap);
        padding-bottom: 2.5rem;
    }

    .footer-terminal-banner {
        padding: 0;
        background: var(--bg-surface);
        border: 1px solid var(--border-medium);
        border-radius: var(--radius-md);
        overflow: hidden;
    }

    .terminal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.25rem;
        background: var(--bg-surface-elevated);
        border-bottom: 1px solid var(--border-subtle);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    .terminal-dots {
        display: flex;
        gap: 6px;
    }

    .terminal-dots .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .dot.red { background: #ef4444; opacity: 0.8; }
    .dot.yellow { background: #f59e0b; opacity: 0.8; }
    .dot.green { background: #10b981; opacity: 0.8; }

    .terminal-status {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--accent-cyan);
        font-weight: 600;
        letter-spacing: 0.05em;
    }

    .terminal-body {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 2rem;
        padding: 2.5rem;
    }

    .terminal-main h2 {
        font-size: clamp(1.8rem, 3.5vw, 2.5rem);
        margin-bottom: 0.75rem;
    }

    .terminal-main p {
        font-size: 1rem;
        max-width: 520px;
        margin-bottom: 1.75rem;
    }

    .terminal-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .terminal-meta {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.25rem;
        padding-left: 2rem;
        border-left: 1px solid var(--border-subtle);
    }

    .meta-item {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .meta-label {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        color: var(--text-muted);
        letter-spacing: 0.08em;
    }

    .social-pills {
        display: flex;
        gap: 0.6rem;
    }

    .social-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.45rem 0.85rem;
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        font-size: 0.85rem;
        color: var(--text-secondary);
        transition: transform 140ms var(--ease-out), color 140ms var(--ease-out), background-color 140ms var(--ease-out), border-color 140ms var(--ease-out);
    }

    .social-pill:hover {
        color: var(--text-primary);
        border-color: var(--border-medium);
        background: var(--bg-surface-hover);
    }

    .social-pill:active {
        transform: scale(0.96);
    }

    .social-pill .arrow-up {
        font-size: 0.75rem;
        transition: transform 0.2s ease;
    }

    .social-pill:hover .arrow-up {
        transform: translate(2px, -2px);
    }

    .footer-legal {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 2rem;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    .tag-loc {
        color: var(--text-secondary);
    }

    @media (max-width: 860px) {
        .terminal-body {
            grid-template-columns: 1fr;
            padding: 1.5rem;
        }

        .terminal-meta {
            padding-left: 0;
            border-left: none;
            border-top: 1px solid var(--border-subtle);
            padding-top: 1.5rem;
        }

        .footer-legal {
            flex-direction: column;
            gap: 0.75rem;
            text-align: center;
        }
    }
</style>
