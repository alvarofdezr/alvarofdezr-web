---
const today = new Date();
import MotionEngine from './MotionEngine.astro';
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale || 'es';
const t = useTranslations(lang as any);
---

<footer class="bento-footer container">
    <div class="footer-grid">
        <div class="footer-block main-block bezel-outer reveal-up">
            <div class="bezel-inner">
                <h2>{t('footer.connect')}</h2>
                <p>{t('footer.connect.desc')}</p>
                <div class="contact-actions">
                    <a href="mailto:alvarofdezr@example.com" class="btn-magnetic">
                        {t('footer.connect.btn')}
                        <div class="icon-wrapper">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" d="M200 216h-40M56 216h40m104-56v56M56 160v56m164-88H36a16 16 0 0 1-16-16V64a16 16 0 0 1 16-16h184a16 16 0 0 1 16 16v48a16 16 0 0 1-16 16ZM20 64l108 72L236 64"/></svg>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <div class="footer-block side-block bezel-outer reveal-up" style="transition-delay: 0.1s;">
            <div class="bezel-inner social-inner">
                <h3>{t('footer.social')}</h3>
                <div class="social-list">
                    <a href="https://github.com/alvarofdezr" target="_blank" rel="noopener noreferrer" class="social-link">
                        <span class="social-name">GitHub</span>
                        <svg class="arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" d="M64 192L192 64M88 64h104v104"/></svg>
                    </a>
                    <a href="https://www.linkedin.com/in/%C3%A1lvaro-fern%C3%A1ndez-71b25a404" target="_blank" rel="noopener noreferrer" class="social-link">
                        <span class="social-name">LinkedIn</span>
                        <svg class="arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" d="M64 192L192 64M88 64h104v104"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="footer-bottom">
        <p>&copy; {today.getFullYear()} {t('footer.rights')}</p>
        <p class="tagline">{t('footer.tagline')}</p>
    </div>
</footer>

<style>
    .bento-footer {
        padding-top: var(--macro-gap);
        padding-bottom: 2rem;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
        margin-bottom: 4rem;
    }

    .main-block .bezel-inner {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.5rem;
        padding: 4rem;
    }

    .main-block h2 {
        font-size: clamp(2.5rem, 5vw, 4rem);
        color: var(--text-primary);
        margin: 0;
    }

    .main-block p {
        color: var(--text-secondary);
        font-size: 1.1rem;
        max-width: 500px;
        line-height: 1.8;
    }

    .contact-actions {
        margin-top: 1rem;
    }

    .side-block .bezel-inner {
        padding: 4rem 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .side-block h3 {
        font-size: 1.5rem;
        color: var(--text-primary);
    }

    .social-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .social-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-inner);
        text-decoration: none;
        color: var(--text-secondary);
        font-size: 1.1rem;
        transition: color 0.4s var(--ease-spring);
    }

    .social-link:last-child {
        border-bottom: none;
    }

    .social-link:hover {
        color: var(--accent);
    }

    .social-link .arrow {
        transition: transform 0.4s var(--ease-spring);
    }

    .social-link:hover .arrow {
        transform: translate(4px, -4px);
    }

    .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid var(--border-outer);
        padding-top: 2rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    @media (max-width: 900px) {
        .footer-grid {
            grid-template-columns: 1fr;
        }
        .main-block .bezel-inner {
            padding: 2.5rem 2rem;
        }
        .footer-bottom {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }
    }
</style>

<MotionEngine />